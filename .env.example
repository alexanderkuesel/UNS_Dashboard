# Copy to .env and edit. .env is git-ignored; on the Pi it lives in the
# deploy directory and is never overwritten by the deploy workflow.

GRAFANA_VERSION=12.4.3
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_ROOT_URL=http://raspberrypi.local:3000/
# Landing page; for MariaDB use .../uns/mariadb/uns-overview-mariadb.json
GRAFANA_HOME_DASHBOARD=/var/lib/grafana/dashboards/uns/timescaledb/uns-overview.json

# --- TimescaleDB historian (leave as-is if you only use MariaDB) ----------
# Where Grafana finds the historian (read-only 'grafana' role from the schema).
#  - TimescaleDB container publishing 5432 on the Pi:  host.docker.internal
#  - TimescaleDB on a shared docker network:          its container name, e.g. timescaledb
#    (see compose.override.example.yml)
#  - the bundled demo database (--profile demo):      demo-db
UNS_PG_HOST=host.docker.internal
UNS_PG_PORT=5432
UNS_PG_DB=home_data
UNS_PG_USER=grafana
UNS_PG_PASSWORD=CHANGE_ME_grafana
UNS_PG_SSLMODE=disable

# --- MariaDB historian (leave as-is if you only use TimescaleDB) ----------
# Same host options as above; the bundled demo database is demo-mariadb.
# Grafana reads the `uns` database (views over `historian`).
UNS_MARIADB_HOST=host.docker.internal
UNS_MARIADB_PORT=3306
UNS_MARIADB_DB=uns
UNS_MARIADB_USER=grafana
UNS_MARIADB_PASSWORD=CHANGE_ME_grafana

# Demo profiles only
TIMESCALEDB_VERSION=2.30.2-pg17
DEMO_PG_ADMIN_PASSWORD=postgres
DEMO_PG_PORT=55432
MARIADB_VERSION=11.4
DEMO_MARIADB_ROOT_PASSWORD=root
DEMO_MARIADB_PORT=53306
