  "panels": [
    {
      "type": "timeseries",
      "title": "${point:text}",
      "description": "Bucket average with the min/max envelope.",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT t.time, t.avg, t.min, t.max FROM ( SELECT FROM_UNIXTIME(FLOOR(UNIX_TIMESTAMP(r.time) / GREATEST(FLOOR($__interval_ms / 1000), 1)) * GREATEST(FLOOR($__interval_ms / 1000), 1)) AS time, r.point_id, AVG(r.value) AS avg, MIN(r.value) AS min, MAX(r.value) AS max, COUNT(*) AS samples FROM uns.readings r WHERE NOT ($__interval_ms >= 3600000 OR $__unixEpochTo() - $__unixEpochFrom() >= 604800) AND r.point_id IN (SELECT p.point_id FROM uns.points p WHERE p.point_id IN (${point:sqlstring})) AND $__timeFilter(r.time) GROUP BY 1, 2 UNION ALL SELECT FROM_UNIXTIME(FLOOR(UNIX_TIMESTAMP(h.time) / GREATEST(FLOOR($__interval_ms / 1000), 3600)) * GREATEST(FLOOR($__interval_ms / 1000), 3600)), h.point_id, SUM(h.avg * h.samples) / NULLIF(SUM(h.samples), 0), MIN(h.min), MAX(h.max), CAST(SUM(h.samples) AS INTEGER) FROM uns.readings_1h h WHERE ($__interval_ms >= 3600000 OR $__unixEpochTo() - $__unixEpochFrom() >= 604800) AND h.point_id IN (SELECT p.point_id FROM uns.points p WHERE p.point_id IN (${point:sqlstring})) AND h.time >= FROM_UNIXTIME(FLOOR($__unixEpochFrom() / 3600) * 3600) AND h.time < $__timeTo() GROUP BY 1, 2) t ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "gradientMode": "opacity"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "max"
            },
            "properties": [
              {
                "id": "custom.fillBelowTo",
                "value": "min"
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "custom.fillOpacity",
                "value": 20
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5794F2"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "min"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5794F2"
                }
              },
              {
                "id": "custom.hideFrom",
                "value": {
                  "legend": true,
                  "tooltip": false,
                  "viz": false
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "avg"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#1F60C4"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "repeat": "point",
      "repeatDirection": "v",
      "id": 1
    },
    {
      "type": "table",
      "title": "Statistics",
      "description": "Computed from raw samples in the selected time range.",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT p.uns_path, p.unit, p.data_type, p.description, p.source_ref, (SELECT r2.value FROM uns.readings r2 WHERE r2.point_id = p.point_id AND $__timeFilter(r2.time) ORDER BY r2.time DESC LIMIT 1) AS last, s.min, s.max, s.avg, s.samples, s.good_pct FROM uns.points p LEFT JOIN ( SELECT r.point_id, MIN(r.value) AS min, MAX(r.value) AS max, AVG(r.value) AS avg, COUNT(*) AS samples, CAST(100.0 * COUNT(CASE WHEN r.quality & 192 = 192 THEN 1 END) / NULLIF(COUNT(*), 0) AS DOUBLE) AS good_pct FROM uns.readings r WHERE r.point_id IN (${point:sqlstring}) AND $__timeFilter(r.time) GROUP BY r.point_id ) s ON s.point_id = p.point_id WHERE p.point_id IN (${point:sqlstring}) ORDER BY p.uns_path"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "uns_path"
            },
            "properties": [
              {
                "id": "custom.minWidth",
                "value": 320
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "good_pct"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "displayName",
                "value": "good quality"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "red"
                    },
                    {
                      "value": 95,
                      "color": "orange"
                    },
                    {
                      "value": 99.5,
                      "color": "green"
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "samples"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 2
    },
    {
      "type": "table",
      "title": "Raw samples (newest 500)",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT r.time, p.uns_path, r.value, r.quality, uns.quality_label(r.quality) AS quality_label FROM uns.readings r JOIN uns.points p USING (point_id) WHERE r.point_id IN (${point:sqlstring}) AND $__timeFilter(r.time) ORDER BY r.time DESC LIMIT 500"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "uns_path"
            },
            "properties": [
              {
                "id": "custom.minWidth",
                "value": 360
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "quality_label"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "status"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ok": {
                        "color": "green",
                        "index": 0
                      },
                      "stale": {
                        "color": "orange",
                        "index": 1
                      },
                      "never": {
                        "color": "red",
                        "index": 2
                      },
                      "disabled": {
                        "color": "text",
                        "index": 3
                      },
                      "good": {
                        "color": "green",
                        "index": 4
                      },
                      "uncertain": {
                        "color": "orange",
                        "index": 5
                      },
                      "bad": {
                        "color": "red",
                        "index": 6
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 3
    }
  ]
}
