        },
        "query": "SELECT p.uns_path AS __text, p.point_id AS __value FROM uns.points p WHERE p.uns_path LIKE CONCAT('%', ${search:sqlstring}, '%') ORDER BY 1",
        "definition": "SELECT p.uns_path AS __text, p.point_id AS __value FROM uns.points p WHERE p.uns_path LIKE CONCAT('%', ${search:sqlstring}, '%') ORDER BY 1",
