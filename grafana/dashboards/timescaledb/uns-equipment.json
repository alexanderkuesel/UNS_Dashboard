        "definition": "SELECT DISTINCT p.measurement FROM uns.points p WHERE p.enterprise IN ($enterprise) AND p.site IN ($site) AND p.area IN ($area) AND p.line IN ($line) AND p.device IN ($device) AND p.measurement IN ($measurement) AND p.data_type <> 'bool' AND p.last_seen IS NOT NULL ORDER BY 1",
