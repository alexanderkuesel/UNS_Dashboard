{
  "uid": "uns-overview",
  "title": "UNS · Enterprise overview",
  "description": "Top of the ISA-95 model: sites, areas and their communication health.",
  "tags": [
    "uns",
    "isa-95",
    "timescaledb",
    "uns-timescaledb"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Data source",
        "type": "datasource",
        "query": "grafana-postgresql-datasource",
        "current": {
          "text": "UNS Historian",
          "value": "uns-historian"
        },
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "enterprise",
        "label": "Enterprise",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${ds}"
        },
        "query": "SELECT DISTINCT p.enterprise FROM uns.points p WHERE TRUE ORDER BY 1",
        "definition": "SELECT DISTINCT p.enterprise FROM uns.points p WHERE TRUE ORDER BY 1",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "sort": 1,
        "hide": 0,
        "regex": ""
      },
      {
        "name": "site",
        "label": "Site",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${ds}"
        },
        "query": "SELECT DISTINCT p.site FROM uns.points p WHERE p.enterprise IN ($enterprise) ORDER BY 1",
        "definition": "SELECT DISTINCT p.site FROM uns.points p WHERE p.enterprise IN ($enterprise) ORDER BY 1",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "sort": 1,
        "hide": 0,
        "regex": ""
      },
      {
        "name": "stale",
        "label": "Stale after",
        "type": "custom",
        "query": "5m : 300,15m : 900,1h : 3600,6h : 21600,1d : 86400",
        "current": {
          "text": "15m",
          "value": "900"
        },
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "options": []
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "title": "UNS",
      "type": "dashboards",
      "tags": [
        "uns-timescaledb"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Model",
      "description": "Size of the selected part of the ISA-95 equipment model.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(DISTINCT p.site) AS \"Sites\", count(DISTINCT (p.site, p.area)) AS \"Areas\", count(DISTINCT (p.site, p.area, p.line, p.device)) AS \"Devices\", count(*) FILTER (WHERE p.enabled) AS \"Points\" FROM uns.points p WHERE p.enterprise IN ($enterprise) AND p.site IN ($site)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Communication",
      "description": "Share of enabled points that reported within the stale window, and the share of non-good OPC quality samples in the time range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round((100.0 * count(*) FILTER (WHERE p.state = 'ok') / NULLIF(count(*) FILTER (WHERE p.state <> 'disabled'), 0))::numeric, 1) AS \"Reporting\", count(*) FILTER (WHERE p.state = 'stale') AS \"Stale\", count(*) FILTER (WHERE p.state = 'never') AS \"Never seen\", (SELECT round((100.0 * count(*) FILTER (WHERE r.quality & 192 <> 192) / NULLIF(COUNT(*), 0))::numeric, 2) FROM uns.readings r WHERE r.point_id IN (SELECT p.point_id FROM uns.points p WHERE p.enterprise IN ($enterprise) AND p.site IN ($site)) AND $__timeFilter(r.time)) AS \"Bad quality\" FROM uns.point_health(${stale} * interval '1 second') p WHERE p.enterprise IN ($enterprise) AND p.site IN ($site)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "orange"
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Reporting"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "red"
                    },
                    {
                      "value": 80,
                      "color": "orange"
                    },
                    {
                      "value": 99,
                      "color": "green"
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Bad quality"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "green"
                    },
                    {
                      "value": 0.5,
                      "color": "orange"
                    },
                    {
                      "value": 5,
                      "color": "red"
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true
      },
      "id": 2
    },
    {
      "type": "nodeGraph",
      "title": "Equipment hierarchy",
      "description": "Enterprise > site > area > line > device. Node is green when the node's newest sample is younger than the stale window.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 14,
        "h": 14
      },
      "targets": [
        {
          "refId": "nodes",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT h.path AS id, h.name AS title, h.level || ' · ' || h.points || ' points' AS subtitle, h.points || ' pts' AS mainstat, h.level AS \"detail__Level\", to_char(h.last_seen, 'YYYY-MM-DD HH24:MI:SS') AS \"detail__Last seen\", CASE WHEN h.last_seen > now() - ${stale} * interval '1 second' THEN 'rgb(115, 191, 105)' ELSE 'rgb(242, 73, 92)' END AS color FROM uns.hierarchy h WHERE h.point_ids && ARRAY(SELECT p.point_id FROM uns.points p WHERE p.enterprise IN ($enterprise) AND p.site IN ($site))"
        },
        {
          "refId": "edges",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT h.parent_path || '->' || h.path AS id, h.parent_path AS source, h.path AS target FROM uns.hierarchy h WHERE h.parent_path IS NOT NULL AND h.point_ids && ARRAY(SELECT p.point_id FROM uns.points p WHERE p.enterprise IN ($enterprise) AND p.site IN ($site))"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "nodes": {},
        "edges": {},
        "layoutAlgorithm": "layered",
        "zoomMode": "cooperative"
      },
      "id": 3
    },
    {
      "type": "table",
      "title": "Areas",
      "description": "Click an area to open it in the Equipment dashboard.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 14,
        "y": 4,
        "w": 10,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT p.enterprise, p.site, p.area, COUNT(DISTINCT p.device) AS devices, count(*) FILTER (WHERE p.state = 'ok') AS ok, count(*) FILTER (WHERE p.state IN ('stale', 'never')) AS problems, MIN(p.age_s) AS last_seen FROM uns.point_health(${stale} * interval '1 second') p WHERE p.enterprise IN ($enterprise) AND p.site IN ($site) GROUP BY 1, 2, 3 ORDER BY 1, 2, 3"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "area"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open ${__data.fields.area}",
                    "url": "/d/uns-equipment/uns-equipment?${ds:queryparam}&${__url_time_range}&var-enterprise=${__data.fields.enterprise}&var-site=${__data.fields.site}&var-area=${__data.fields.area}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "problems"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "transparent"
                    },
                    {
                      "value": 1,
                      "color": "red"
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "custom.width",
                "value": 85
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "last_seen"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "displayName",
                "value": "last seen (s ago)"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "green"
                    },
                    {
                      "value": 900,
                      "color": "orange"
                    },
                    {
                      "value": 86400,
                      "color": "red"
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "enterprise"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "site"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "devices"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 75
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ok"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 55
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Samples by site",
      "description": "Stored samples per time bucket: a drop means a site stopped publishing.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT t.time, p.site AS metric, SUM(t.samples) AS value FROM uns.trend(ARRAY(SELECT p.point_id FROM uns.points p WHERE p.enterprise IN ($enterprise) AND p.site IN ($site)), $__timeFrom(), $__timeTo(), $__interval_ms * interval '1 millisecond') t JOIN uns.points p USING (point_id) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false,
            "gradientMode": "opacity",
            "stacking": {
              "mode": "normal"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Reporting points by site",
      "description": "Distinct points with at least one sample per bucket.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT t.time, p.site AS metric, COUNT(DISTINCT t.point_id) AS value FROM uns.trend(ARRAY(SELECT p.point_id FROM uns.points p WHERE p.enterprise IN ($enterprise) AND p.site IN ($site)), $__timeFrom(), $__timeTo(), $__interval_ms * interval '1 millisecond') t JOIN uns.points p USING (point_id) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "gradientMode": "opacity",
            "lineInterpolation": "stepAfter"
          },
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6
    }
  ]
}
